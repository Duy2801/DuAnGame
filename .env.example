# Chép thành .env.local rồi điền (xem ONLINE.md). Để trống VITE_* = chơi offline, BXH đấu với bot.
# KHÔNG BAO GIỜ ghi mật khẩu thật vào file này.

# Chỉ dùng cho script dựng database (npm run db:apply) — không đóng gói vào web
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Frontend
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_EMAIL_DOMAIN=example.com
# (tuỳ chọn) Cloudflare Turnstile chống bot — bật thêm trong Supabase → Authentication → Bot and Abuse Protection
VITE_TURNSTILE_SITE_KEY=
